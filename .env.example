# Server & Dashboard Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_min_32_characters_here

# Admin Default Credentials (Single Login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_immediately

# Database Configuration (Local SQLite or Turso Cloud)
# For local SQLite: file:./data/database.sqlite
# For Turso: libsql://[your-db].turso.io
DATABASE_URL=file:./data/database.sqlite
DATABASE_AUTH_TOKEN=

# WhatsApp Configuration
AUTH_FOLDER=./data/auth_info_baileys
MAIN_CLASS_GROUP_JID=
